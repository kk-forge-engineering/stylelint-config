{
  "name": "@kk-forge/stylelint-config",
  "version": "1.0.1",
  "description": "The stylelint rules KK Forge's CSS lints with",
  "license": "MIT",
  "author": "KK Forge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kk-forge-engineering/stylelint-config.git"
  },
  "files": [
    "base.js",
    "css-modules.js",
    "tailwind.js"
  ],
  "type": "module",
  "exports": {
    "./base": "./base.js",
    "./css-modules": "./css-modules.js",
    "./tailwind": "./tailwind.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "npm run lint:tsc && npm run lint:oxlint && npm run lint:format",
    "lint:fix": "npm run lint:oxlint:fix && npm run lint:format:fix",
    "lint:tsc": "tsc",
    "lint:oxlint": "oxlint",
    "lint:oxlint:fix": "oxlint --fix",
    "lint:format": "oxfmt --check .",
    "lint:format:fix": "oxfmt .",
    "test": "node --test test/configs.test.ts"
  },
  "dependencies": {
    "stylelint-config-standard": "^41.0.0"
  },
  "devDependencies": {
    "@kk-forge/oxlint-config": "^2.0.0",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "stylelint": "^18.0.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "stylelint": "^18.0.0"
  }
}
